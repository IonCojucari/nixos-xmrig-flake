# Per-rig secrets: XMRig API tokens, Glances passwords and the admin password
# hash, generated by scripts/mk-secrets.sh and handed to
# `nixos-anywhere --extra-files`. They live here rather than in the flake
# because /nix/store is world-readable.
secrets/

# Nix build outputs.
#
# In a non-git directory Nix copies *every* file into the flake source, so a
# `result` symlink left in the tree changes the source hash and every build
# invalidates the one before it.
#
# Prefer keeping out-links outside the tree entirely:
#   nix build .#vm -o ~/miner-vm
result
result-*

# direnv / nix-direnv
.direnv/
.envrc.local

# Editor and OS noise
*.swp
*~
.DS_Store
hosts/miner/local.nix
